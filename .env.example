# Public browser token from Mapbox. Never put a secret (sk.) token here.
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=YOUR_PUBLIC_MAPBOX_TOKEN

# PostgreSQL connection used by Prisma and the server runtime.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public

# Generate a private value with: pnpm exec auth secret
AUTH_SECRET=GENERATE_A_PRIVATE_SECRET

# Google OAuth credentials from Google Cloud Console.
# Authorized redirect URI for local development: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=YOUR_GOOGLE_OAUTH_CLIENT_ID
AUTH_GOOGLE_SECRET=YOUR_GOOGLE_OAUTH_CLIENT_SECRET

# Optional email/password registration and verification.
# Required in production when enabling registration.
RESEND_API_KEY=YOUR_RESEND_API_KEY
AUTH_EMAIL_FROM=Territorio <cuentas@example.com>
# Public application URL used to create verification links.
AUTH_URL=http://localhost:3000

# Optional fictitious-only shared demo access. Keep these server-side; never use customer records.
DEMO_ACCESS_ENABLED=false
DEMO_ADMIN_USERNAME=admin
DEMO_ADMIN_PASSWORD=SET_SERVER_SIDE_FOR_THE_FICTITIOUS_DEMO
DEMO_ADMIN_EMAIL=admin@demo.invalid
DEMO_AGENCY_SLUG=territorio-fictitious-demo
# Explicitly opt in before running `pnpm db:seed:demo-access`; the seed only permits local PostgreSQL.
DEMO_DATA_SEED=false
